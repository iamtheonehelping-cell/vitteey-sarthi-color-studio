---
import BaseLayout from '../layouts/BaseLayout.astro';
import { CURATED_PALETTES } from '../data/palettes';
---

<BaseLayout
  title="Color Palettes"
  description="Browse curated color palettes for design projects — ocean, sunset, forest, and monochrome combinations ready to preview and export."
>
  <h1 class="mb-6 text-3xl font-bold text-text">Curated Palettes</h1>
  <div class="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">
    {
      CURATED_PALETTES.map((palette) => (
        <a
          href={`/palette/${palette.slug}`}
          class="block overflow-hidden rounded-lg border border-border bg-surface transition-shadow hover:shadow-md"
        >
          <div class="flex h-28">
            {palette.colors.map((c) => (
              <span class="flex-1" style={`background-color: ${c}`} />
            ))}
          </div>
          <div class="p-3">
            <p class="font-semibold text-text">{palette.name}</p>
            <p class="text-sm text-text-muted">{palette.description}</p>
          </div>
        </a>
      ))
    }
  </div>
</BaseLayout>
