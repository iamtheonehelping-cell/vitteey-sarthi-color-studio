---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="About"
  description="Vitteey Sarthi Color Studio is a free, privacy-friendly color palette generator and color tools website. Learn how it works."
>
  <h1 class="mb-4 text-3xl font-bold text-text">About Vitteey Sarthi Color Studio</h1>
  <div class="max-w-2xl space-y-4 text-text-muted">
    <p>
      Vitteey Sarthi Color Studio, a product of Vitteey Sarthi LLP, is a free color palette
      generator and set of color tools for designers and developers. Generate harmonious
      palettes from any base color, check contrast for accessibility, and export colors in the
      format you need — CSS, JSON, or a shareable PNG image.
    </p>
    <p>
      Everything runs in your browser. Saved palettes are stored using your browser's local
      storage only — nothing is sent to a server, and there's no account required.
    </p>
  </div>
</BaseLayout>
