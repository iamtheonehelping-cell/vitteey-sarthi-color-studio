---
// Plain vanilla JS, no React — a theme toggle doesn't need a framework
// island. Respects system preference by default; an explicit click
// overrides it and persists to localStorage (read back by the blocking
// inline script in BaseLayout's <head> to avoid a flash of wrong theme).
---

<button
  id="theme-toggle"
  type="button"
  aria-label="Toggle light and dark theme"
  aria-pressed="false"
  class="inline-flex h-9 w-9 items-center justify-center rounded-md border border-border text-text transition-colors hover:bg-surface-subtle"
>
  <svg
    id="theme-icon-sun"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="h-5 w-5"
    aria-hidden="true"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"
    ></path>
  </svg>
  <svg
    id="theme-icon-moon"
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    class="h-5 w-5"
    aria-hidden="true"
    style="display: none;"
  >
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
  </svg>
  <span id="theme-toggle-status" class="sr-only" aria-live="polite"></span>
</button>

<script is:inline>
  (function () {
    function getEffectiveTheme() {
      var root = document.documentElement;
      if (root.classList.contains('dark')) return 'dark';
      if (root.classList.contains('light')) return 'light';
      return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
    }

    function updateIcons() {
      var theme = getEffectiveTheme();
      var sun = document.getElementById('theme-icon-sun');
      var moon = document.getElementById('theme-icon-moon');
      var btn = document.getElementById('theme-toggle');
      if (!sun || !moon || !btn) return;
      sun.style.display = theme === 'dark' ? 'none' : '';
      moon.style.display = theme !== 'dark' ? 'none' : '';
      btn.setAttribute('aria-pressed', theme === 'dark' ? 'true' : 'false');
    }

    function toggleTheme() {
      var next = getEffectiveTheme() === 'dark' ? 'light' : 'dark';
      document.documentElement.classList.remove('dark', 'light');
      document.documentElement.classList.add(next);
      try {
        localStorage.setItem('vsc-theme', next);
      } catch (e) {
        /* localStorage unavailable — theme just won't persist */
      }
      updateIcons();
      var status = document.getElementById('theme-toggle-status');
      if (status) status.textContent = next === 'dark' ? 'Dark mode enabled' : 'Light mode enabled';
    }

    var btn = document.getElementById('theme-toggle');
    if (btn) btn.addEventListener('click', toggleTheme);
    updateIcons();
  })();
</script>
